/**********************************************************************************************************************
 *                                              P L E A S E   N O T E
 *
 * The attributes in this file must not be changed. Missing mandatory attributes must be set in the including file.
 * They are presented as a comment in the corresponding object definition containing a list of all legal values.
 *********************************************************************************************************************/

   TASK OsTask_10ms {
      ACTIVATION = 1:"@RO@";
      PRIORITY = 2:"@RO@";
      SCHEDULE = FULL:"@RO@";
// TIMING_PROTECTION = FALSE|TRUE; (AUTOSAR OS only)
      AUTOSTART = FALSE:"@RO@";
   }:"@RO@@NR@";

   ALARM Rte_Al_TE_HIL_Controller_Run_HIL_PI_10ms {
      COUNTER = SystemTimer;
      ACTION = ACTIVATETASK
      {
         TASK = OsTask_10ms;
      }:"@ROC@";
      AUTOSTART = FALSE:"@RO@";
   }:"@RO@@NR@";

   TASK OsTask_BSW {
      ACTIVATION = 1:"@RO@";
      PRIORITY = 1:"@RO@";
      SCHEDULE = FULL:"@RO@";
// TIMING_PROTECTION = FALSE|TRUE; (AUTOSAR OS only)
      AUTOSTART = FALSE:"@RO@";
      EVENT = Rte_Ev_Cyclic2_OsTask_BSW_0_10ms:"@RO@";
      EVENT = Rte_Ev_Cyclic2_OsTask_BSW_0_20ms:"@RO@";
   }:"@RO@@NR@";

   ALARM Rte_Al_TE2_OsTask_BSW_0_10ms {
      COUNTER = SystemTimer;
      ACTION = SETEVENT
      {
         TASK = OsTask_BSW;
         EVENT = Rte_Ev_Cyclic2_OsTask_BSW_0_10ms;
      }:"@ROC@";
      AUTOSTART = FALSE:"@RO@";
   }:"@RO@@NR@";

   ALARM Rte_Al_TE2_OsTask_BSW_0_20ms {
      COUNTER = SystemTimer;
      ACTION = SETEVENT
      {
         TASK = OsTask_BSW;
         EVENT = Rte_Ev_Cyclic2_OsTask_BSW_0_20ms;
      }:"@ROC@";
      AUTOSTART = FALSE:"@RO@";
   }:"@RO@@NR@";

   EVENT Rte_Ev_Cyclic2_OsTask_BSW_0_10ms {
      MASK = AUTO;
   }:"@ROC@@NR@";

   EVENT Rte_Ev_Cyclic2_OsTask_BSW_0_20ms {
      MASK = AUTO;
   }:"@ROC@@NR@";
